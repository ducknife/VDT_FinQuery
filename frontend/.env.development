# cấu hình khi chạy `npm run dev`; không chứa bí mật (finquery-web là public client).
# trang đăng nhập của FinQuery gửi email + mật khẩu tới Keycloak để lấy token (QĐ-045).
# muốn chạy không đăng nhập (backend finq.security.enabled=false): tạo .env.development.local với VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=finquery
VITE_KEYCLOAK_CLIENT=finquery-web
